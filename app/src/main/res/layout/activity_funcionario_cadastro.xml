<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/funcionarioCadastroScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            tools:context=".FuncionarioCadastroActivity">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarCadastroFuncionario"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginBottom="16dp"
                android:background="@color/background"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:logo="@mipmap/ic_launcher_round"
                app:menu="@menu/menu_main"
                app:title="TagSafe"
                app:titleTextColor="@color/turquoise" />

            <TextView
                android:id="@+id/textViewBemVindoCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Olá!"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewUnidadeCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Cadastro vinculado à unidade."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Cadastrar funcionário"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="22dp"
                        android:text="Preencha os dados e escolha o cadastro por NFC ou facial."
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Unidade"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutUnidadeFuncionario"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/turquoise"
                        app:startIconDrawable="@drawable/ic_location"
                        app:startIconTint="@color/turquoise">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerUnidadeFuncionario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Nome"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/turquoise">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextNomeFuncionario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLength="120"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="CPF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/turquoise">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextCpfFuncionario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="14"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Setor (opcional)"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/turquoise">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextSetorDescricao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLength="80"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="22dp"
                        android:hint="Nível do setor (opcional)"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/turquoise">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextSetorNivel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLength="20"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox android:id="@+id/checkAdicionarNfc"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/registration_add_nfc" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNfcCadastro"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/turquoise_light"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/turquoise"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/textViewNfcStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="Aproxime o crachá do celular para preencher o NFC."
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="NFC do crachá"
                                app:boxBackgroundColor="@color/white"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxStrokeColor="@color/turquoise"
                                app:startIconDrawable="@drawable/ic_nfc"
                                app:startIconTint="@color/turquoise">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextNfcFuncionario"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:singleLine="true"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonLimparNfc"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                android:text="Limpar crachá"
                                android:textColor="@color/turquoise" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <CheckBox android:id="@+id/checkCadastroFacial"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/registration_add_face" />
                    <LinearLayout android:id="@+id/layoutFotoCadastro"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone"
                        android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/textViewFotoCadastro"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/registration_photo_required" android:textColor="@color/turquoise"
                            android:accessibilityLiveRegion="polite" android:padding="12dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonFotoCadastro"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/registration_capture_face" />
                    </LinearLayout>
                    <TextView android:id="@+id/textViewCadastroStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/registration_choose_method" android:textColor="@color/text_secondary"
                        android:layout_marginBottom="16dp" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCadastrarFuncionario"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Cadastrar funcionário"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/turquoise"
                        app:cornerRadius="16dp"
                        app:elevation="6dp" />

                    <ProgressBar
                        android:id="@+id/progressBarCadastroFuncionario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
